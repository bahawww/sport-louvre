{
	auto_https off
	admin off
}

:8310 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Portraits and crests keep their file name when replaced, so cache for a day, not forever.
	@media path /media/*
	header @media >Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Downloads are rebuilt in place under the same name, so no edge or browser copy may outlive them.
	@downloads path /api/datasets/download/*
	header @downloads >Cache-Control "no-store"

	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
